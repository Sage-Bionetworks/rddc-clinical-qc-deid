// Shared configuration, loaded for every pipeline in this repo.
//
// Cirro runs workflows/<name>/main.nf from the repo root, so this is the only
// nextflow.config Nextflow reads. Pipeline-specific parameter defaults belong at the top
// of each main.nf. Cirro adds its own config for the executor, work directory and AWS;
// don't set those here.

manifest {
    name            = 'rddc-clinical-qc-deid'
    description     = 'RDDC intake checks for clinical data (FHIR, OMOP): identifier screens and QC'
    homePage        = 'https://github.com/Sage-Bionetworks/rddc-clinical-qc-deid'
    nextflowVersion = '!>=25.04.0'
}

// Parameters every pipeline accepts. Cirro sets outdir (.cirro/<name>/process-input.json),
// and each pipeline's sidecar (.cirro/<name>/preprocess.py).
params {
    outdir = null   // where results are published
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // No container: the tools must be on PATH (make venv; PATH=.venv/bin:$PATH).
    local {
        process.container = null
    }
    // Small resources for CI and laptops. Pass the test input with --sidecar.
    test {
        params.outdir = 'results'
        process {
            resourceLimits = [cpus: 2, memory: '6.GB', time: '1.h']
        }
    }
}
